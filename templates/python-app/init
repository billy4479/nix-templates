#!/usr/bin/env sh
set -eu

if [ -d .git ]; then
  echo "Refusing to initialize: .git already exists" >&2
  exit 1
fi

project_name="$(basename "$PWD")"
module_name="$(printf '%s' "$project_name" | tr '-' '_' | tr -c '[:alnum:]_' '_')"

mkdir -p "src/$module_name"

sed_escape() {
  printf '%s' "$1" | sed 's/[\/&]/\\&/g'
}

project_name_escaped="$(sed_escape "$project_name")"
module_name_escaped="$(sed_escape "$module_name")"

sed \
  -e "s/__PROJECT_NAME__/$project_name_escaped/g" \
  -e "s/__MODULE_NAME__/$module_name_escaped/g" \
  pyproject.toml.in > pyproject.toml
sed \
  -e "s/__PROJECT_NAME__/$project_name_escaped/g" \
  __init__.py.in > "src/$module_name/__init__.py"
mv __main__.py.in "src/$module_name/__main__.py"

rm -- pyproject.toml.in __init__.py.in
rm -- "$0"
git init
git add .
git commit -m "Initial commit"
